# Supabase project credentials (get these from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. If set, share links use this as the canonical origin
# instead of the browser's current window.location.origin. Useful if
# you want shared links to always point at your custom domain even
# when the app happens to be viewed via a Cloudflare Pages preview URL.
# Leave unset to just use whatever origin is actually serving the page.
NEXT_PUBLIC_SITE_URL=
